# Required: generate unique secrets; never commit .env
NODE_ENV=production
APP_ORIGIN=https://central.albyn.site
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
PIN_PEPPER=CHANGE_ME_DIFFERENT_RANDOM_SECRET
HOST_HELPER_TOKEN=CHANGE_ME_HOST_HELPER_TOKEN
DOCKER_GATEWAY_TOKEN=CHANGE_ME_DIFFERENT_DOCKER_GATEWAY_TOKEN
DATABASE_URL=postgresql://homelab_central:CHANGE_ME_DB_PASSWORD@postgres:5432/homelab_central?schema=public
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_URL=redis://redis:6379
DOCKER_GATEWAY_URL=http://docker-gateway:4100
HOST_HELPER_URL=http://host.docker.internal:4200
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Homelab Central <homelab@example.com>
BACKUP_ROOT=/backups
TRAEFIK_NETWORK=homelab
TRAEFIK_HOST=central.albyn.site
# Optional: What's Up Docker — Updates page pulls available image upgrades from here
WUD_URL=http://host.docker.internal:3000
WUD_API_TOKEN=
# Or use HTTP basic instead of token:
WUD_USER=
WUD_PASSWORD=
